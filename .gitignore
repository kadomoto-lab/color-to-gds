# Local Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Test / analysis caches and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Downloaded tools, optical simulation caches, and local logs
/.tools/
/.cache/
*.log

# Local calculation outputs (web jobs, CLI runs, palette exports, etc.).
# Keep the bundled case studies required by the GUI/tests and their reports.
/runs/*
!/runs/index.html
!/runs/case_comparison.png
!/runs/case_metadata.json
!/runs/sky130_zundamon/
!/runs/soi_al_zundamon/
!/runs/sky130_metan/
!/runs/soi_al_metan/

# Keep audit code and notes; exclude generated numerical results and caches.
!/runs/model_audit/
/runs/model_audit/*
!/runs/model_audit/*.py
!/runs/model_audit/*.md
!/runs/verification_latest/
/runs/verification_latest/*
!/runs/verification_latest/*.py
!/runs/verification_latest/*.md

# Do not exclude data formats globally: NPZ/GDS/PNG/CSV/JSON are also sample assets.

# Local environment settings (templates can be shared)
.env
.env.*
!.env.example

# OS / editor temporary files and crash dumps
.DS_Store
Thumbs.db
*.swp
*.swo
*~
core
core.[0-9]*

# Existing local, one-off report helpers
/upgrade_report.py
/finalize.py
/finish_report.py

# Optional SkyWater PDK figure copied by scripts/bootstrap.py (Apache-2.0, not redistributed here)
/data/sky130_stack.svg
